#!/bin/sh
# Fetches the pinned Beads (bd) release binary into ./bin/bd if it isn't
# already there at the right version. macOS only (arm64 or amd64).
set -eu

BD_VERSION="1.3.0"
# sha256 of the release tarball itself (from upstream checksums.txt), used to
# verify the download before extracting.
BD_TARBALL_SHA256_ARM64="7cc77367d0b84c50243a1108bc1f73648699211257d414b917540bf868e6bb85"
BD_TARBALL_SHA256_AMD64="dfd8a6918bc2a58a0dbc727f7e4039766e323dfa15e4ccab250d640851e290d5"
# sha256 of the extracted bd binary itself, used to skip re-downloading when
# ./bin/bd is already at the pinned version.
BD_BIN_SHA256_ARM64="86e81a32d7b7cf3309a343210fac65e5a5ac485102c604447bf37d45aac675f0"
BD_BIN_SHA256_AMD64="68538406c921213e7cd9239c8c301fc6d144f06b0a57807839dd7dbe50dd1433"

here="$(cd "$(dirname "$0")" && pwd)"
target="$here/bd"

if [ "$(uname -s)" != "Darwin" ]; then
  echo "ensure-bd: Beads pins a macOS bd binary; $(uname -s) is not supported" >&2
  exit 1
fi

case "$(uname -m)" in
  arm64) asset_arch="arm64"; expected_tarball_sha="$BD_TARBALL_SHA256_ARM64"; expected_bin_sha="$BD_BIN_SHA256_ARM64" ;;
  x86_64) asset_arch="amd64"; expected_tarball_sha="$BD_TARBALL_SHA256_AMD64"; expected_bin_sha="$BD_BIN_SHA256_AMD64" ;;
  *) echo "ensure-bd: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

if [ -x "$target" ]; then
  current_sha="$(shasum -a 256 "$target" | awk '{print $1}')"
  if [ "$current_sha" = "$expected_bin_sha" ]; then
    exit 0
  fi
fi

asset="beads_${BD_VERSION}_darwin_${asset_arch}.tar.gz"
url="https://github.com/gastownhall/beads/releases/download/v${BD_VERSION}/${asset}"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

echo "ensure-bd: fetching bd v${BD_VERSION} (darwin/${asset_arch})..." >&2
curl -fsSL "$url" -o "$tmp/$asset"

downloaded_sha="$(shasum -a 256 "$tmp/$asset" | awk '{print $1}')"
if [ "$downloaded_sha" != "$expected_tarball_sha" ]; then
  echo "ensure-bd: checksum mismatch for $asset" >&2
  echo "  expected $expected_tarball_sha" >&2
  echo "  got      $downloaded_sha" >&2
  exit 1
fi

tar -xzf "$tmp/$asset" -C "$tmp" ./bd
extracted_sha="$(shasum -a 256 "$tmp/bd" | awk '{print $1}')"
if [ "$extracted_sha" != "$expected_bin_sha" ]; then
  echo "ensure-bd: extracted binary checksum mismatch" >&2
  echo "  expected $expected_bin_sha" >&2
  echo "  got      $extracted_sha" >&2
  exit 1
fi

mv "$tmp/bd" "$target"
chmod +x "$target"
echo "ensure-bd: installed bd v${BD_VERSION} to $target" >&2
