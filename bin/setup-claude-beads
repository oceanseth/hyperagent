#!/usr/bin/env python3
"""Install upstream Claude hooks while keeping instructions in AGENTS.md only."""
import json
from pathlib import Path
import subprocess
import tempfile

root = Path(__file__).resolve().parent.parent
# bd 1.3.0 hardcodes CLAUDE.md. Generate its recipe in scratch space, then merge
# only the native hooks into this project. Never create CLAUDE.md in the project.
with tempfile.TemporaryDirectory(prefix="hackalon-claude-beads-") as scratch:
    subprocess.run([str(root / "bin/bd"), "setup", "claude"], cwd=scratch,
                   check=True, stdout=subprocess.DEVNULL)
    generated = json.loads((Path(scratch) / ".claude/settings.json").read_text())

path = root / ".claude/settings.json"
settings = json.loads(path.read_text()) if path.exists() else {}
hooks = settings.setdefault("hooks", {})
for event, entries in generated.get("hooks", {}).items():
    current = hooks.setdefault(event, [])
    for entry in entries:
        if entry not in current:
            current.append(entry)
path.parent.mkdir(exist_ok=True)
path.write_text(json.dumps(settings, indent=2) + "\n")
assert not (root / "CLAUDE.md").exists(), "Use shared AGENTS.md only"
print("Claude Beads hooks installed; shared instructions: AGENTS.md")
