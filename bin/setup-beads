#!/usr/bin/env bash
# One-time setup for a fresh clone. Hermit fetches the pinned bd and dolt on
# first use, so nothing needs to be installed beforehand.
set -eu
project_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$project_dir"
. bin/activate-hermit >/dev/null
bd init --init-if-missing --non-interactive --skip-agents --skip-hooks
bd hooks install --beads
bd setup codex
python3 bin/setup-claude-beads
bd dolt pull
bd ready
